```gitignore
# Build artifacts and compiled files
*.o
*.obj
*.out
*.bin
*.hex
*.elf

# Dependencies and packages
node_modules/
venv/
.venv/
__pycache__/
.pipenv/
poetry.lock

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak

# Environment files
.env
.env.local
*.env.*

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Build directories
build/
dist/
target/
```